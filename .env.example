PORT=8080
DATABASE_URL=postgres://logforge:logforge@postgres:5432/logforge
RABBITMQ_URL=amqp://logforge:logforge@rabbitmq:5672
REDIS_URL=redis://redis:6379
CACHE_TTL_MS=5000
RETENTION_DAYS=30
LOG_LEVEL=warn
QUEUE_FLUSH_INTERVAL_MS=250
QUEUE_MAX_BATCH_LOGS=5000
QUEUE_WRITE_CONCURRENCY=1
QUEUE_METRICS_INTERVAL_MS=0
QUEUE_CONSUMER_ENABLED=true
